<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:js='false' b:layoutsVersion='3' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta expr:charset='data:blog.encoding'/>
  <meta content='width=device-width,initial-scale=1' name='viewport'/>
  <title>@snippet</title>
  <link expr:href='data:blog.blogspotFaviconUrl' rel='icon' type='image/x-icon'/>
  <b:skin><![CDATA[
    /* Demo */
    * { margin: 0 }
    body {
      background-color: #fff;
      padding: 2rem;
    }

    /*Test*/
    article {
      max-width: 700px;
      margin-bottom: 2rem;
    }
  ]]></b:skin>
  <b:defaultmarkups>
    <b:defaultmarkup type='Common'>
      <b:includable id='@snippet'>
        <b:comment>
        Creates a clean text snippet of a string with conditional ellipsis support.
        @author zkreations
        @param {String} [text=""] - Text or HTML content to be shortened
        @param {String} [tag="p"] - Container HTML tag name
        @param {String} [id] - Container HTML id
        @param {String} [class] - Container CSS class
        @param {Number} [limit=70] - Maximum length of the string
        @param {String} [ellipsis="..."] - Ellipsis to be added only if the text is truncated
        </b:comment>
        <b:with value='data:text ? (data:text snippet {
          links: false,
          ellipsis: false,
          linebreaks: false
        }) : ""' var='cleanString'>
          <b:if cond='data:cleanString != ""'>
            <b:with value='(data:limit + 0) == data:limit
              ? (data:limit * 1)
              : 70' var='maxLength'>
              <b:tag expr:name='data:tag ?: "p"'>
                <b:class cond='data:class' expr:name='data:class'/>
                <b:attr name='id' expr:value='data:id'/>
                <b:with value='data:cleanString snippet {
                  length: data:maxLength,
                  links: false,
                  ellipsis: false,
                  linebreaks: false
                }' var='truncatedText'>
                  <b:eval expr='data:truncatedText + (
                    data:cleanString.size > data:maxLength ? (data:ellipsis ?: "...") : ""
                  )'/>
                </b:with>
              </b:tag>
            </b:with>
          <b:else/>
            <b:comment render='true'>Text parameter is empty. Please provide a valid string.</b:comment>
          </b:if>
        </b:with>
      </b:includable>
    </b:defaultmarkup>
    <b:defaultmarkup type="Blog">
